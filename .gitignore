# === Configuration ===
config.yaml
.env
*.env
.env.local
.env.*.local

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.user

# === OS ===
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
